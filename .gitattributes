# Keep formatter-sensitive source and repository text stable across platforms.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitattributes text eol=lf

# PowerShell scripts remain native Windows text files when checked out there.
*.ps1 text eol=crlf
